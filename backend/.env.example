# ============================================================
# H/E Travellers CTF Platform - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment

# CTF Mode - MUST be true for isolated operation
CTF_MODE=true

# Security Controls (keep false for CTF isolation)
ALLOW_EXTERNAL_NETWORK=false
ALLOW_REAL_PAYMENT=false
ALLOW_REAL_EMAIL=false
ALLOW_REAL_SMS=false

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://www.hetravellers.local

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hetravellers
DB_USER=hetravellers
DB_PASSWORD=ctf_secret_2024

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=he_travellers_jwt_secret_ctf_2024_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=he_travellers_refresh_jwt_secret_ctf_2024

# Session
SESSION_SECRET=he_travellers_session_ctf_2024_change_in_production
SESSION_MAX_AGE=86400000

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Internal Services (mock only)
INTERNAL_API_URL=http://internal-api.hetravellers.local:8080
MOCK_PAYMENT_URL=http://payments.hetravellers.local

# Organizer
ORGANIZER_SECRET=HE_ORGANIZER_MASTER_2024

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_CTF_DASHBOARD=true
ENABLE_WEBSOCKETS=true
